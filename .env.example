# Copy this file to .env. Never commit .env or any real credential.
# AUTH_MODE=mock is allowed only in development/test and is rejected in production.
# Application
APP_ENV=development
AUTH_MODE=mock
FRONTEND_ORIGIN=http://localhost:5173

# Local MySQL 8. Keep the real password only in the untracked .env file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=kol_insight
MYSQL_USER=root
MYSQL_PASSWORD=

# Use a random value with at least 32 characters outside tests. Keep it only in .env.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# Phase two AI and DataTap settings. Keep real tokens only in .env.
# Any OpenAI-compatible provider works: set base URL, model name and key below.
# Tencent Token Plan (default): https://tokenhub.tencentmaas.com/plan/v3 + deepseek-v4-pro
# Moonshot Kimi example: TENCENT_PLAN_BASE_URL=https://api.moonshot.cn/v1, TENCENT_PLAN_MODEL=kimi-k2-0905-preview
TENCENT_PLAN_BASE_URL=https://tokenhub.tencentmaas.com/plan/v3
TENCENT_PLAN_MODEL=deepseek-v4-pro
TENCENT_PLAN_API_KEY=
# Optional reasoning effort (top-level reasoning_effort): low/high/max, only honored by
# reasoning models such as Kimi k3; leave empty to omit the parameter entirely.
TENCENT_PLAN_REASONING_EFFORT=
# GoalPlanner 影子模式：只记录目标规划，不改变现有任务执行；仅在 UAT 观察期启用。
GOAL_PLANNER_SHADOW_ENABLED=false
# GoalPlanner 正式接管（单 Goal 规划）：开启后 ready 会话的每条消息先经 planner
# 决定 clarify/execute；planner 失败自动回退 kol_selection。默认关闭（灰度）。
GOAL_PLANNER_ENFORCE_ENABLED=false
MODEL_TIMEOUT_SECONDS=60
# 单次模型决策整次墙钟上限（每次 create 尝试含整个流消费），须小于 Agent Run
# 租约时长（300s）；超时取消本次尝试并按可重试 MODEL_TIMEOUT 在重试预算内重试。
MODEL_DECISION_TIMEOUT_SECONDS=240
DATATAP_MCP_TOKEN=
RUNTIME_SECRET_MASTER_KEYS=
RUNTIME_SECRET_ACTIVE_KEY_VERSION=v1
DATATAP_READ_TIMEOUT_SECONDS=60
MCP_CALL_POINTS=10
MCP_UNKNOWN_RECONCILE_SECONDS=300
TASK_LEASE_SECONDS=60
# 用户上传：本地存储目录、单文件大小上限（20 MiB）、最大数据行数（50,000）。
AGENT_UPLOAD_STORAGE_DIR=.data/agent-uploads
AGENT_UPLOAD_MAX_BYTES=20971520
AGENT_UPLOAD_MAX_ROWS=50000
AGENT_EXPORT_STORAGE_DIR=.data/agent-exports

# Pi RPC POC：默认关闭，只允许配置为专用 kol_insight_pi_poc 数据库的 test 环境使用。
PI_RUNTIME_POC_ENABLED=false
# 在未跟踪的 .env 中生成并保存随机值；不要提交真实值。
PI_RUNTIME_POC_INTERNAL_SECRET=
PI_RUNTIME_POC_BASE_URL=http://127.0.0.1:8000/api/v1/internal/pi-poc
PI_RUNTIME_POC_RUN_TIMEOUT_SECONDS=1800
PI_RUNTIME_POC_MCP_TIMEOUT_SECONDS=180
PI_RUNTIME_POC_MAX_DECISIONS=50

# Production Pi Gateway internal control plane (leave empty until a local/fake
# Gateway is explicitly configured; never reuse the POC secret in production).
PI_GATEWAY_INTERNAL_SECRET=
PI_GATEWAY_ALLOWED_IDS=
PI_GATEWAY_LEASE_SECONDS=60
PI_GATEWAY_CONTROL_PLANE_URL=
